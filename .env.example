# Environment variables for local development.
#
# No variables are required right now.
#
# The Weather & Travel Explorer project uses the free Open-Meteo API
# (https://open-meteo.com), which does not need an API key.
#
# If you later switch to a weather provider that needs a key, copy this
# file to `.env` and read the key in code with import.meta.env.VITE_WEATHER_API_KEY.
# Never commit a real key.
VITE_WEATHER_API_KEY=
